{
  "name": "raceui",
  "version": "0.1.0",
  "description": "Lightweight, agent-friendly concurrency testing toolkit for discovering race conditions through real browser interactions.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "raceui": "dist/cli/index.js",
    "raceui-playground": "playground/server.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "examples",
    "playground",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "playground": "node playground/server.mjs",
    "logo": "python scripts/generate-logo.py",
    "prepublishOnly": "npm run build",
    "pretest:integration": "npm run build",
    "bench": "node scripts/benchmark.mjs",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "keywords": [
    "race-condition",
    "concurrency",
    "testing",
    "playwright",
    "qa",
    "e2e",
    "agent-skill",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modalqa/raceUI.git"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "playwright": "^1.65.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
